@page
@model VideoGameCollection.Pages.Collection.CreateModel
@{
    ViewData["Title"] = "Aggiungi Gioco";
    var platforms = new[] { "PC", "PlayStation 5", "PlayStation 4", "Xbox Series X/S", "Xbox One", "Nintendo Switch", "iOS", "Android", "Altro" };
}

<div class="form-page">
    <div class="form-header">
        <a asp-page="/Collection/Index" class="back-link">← Torna alla collezione</a>
        <h1>➕ Aggiungi Gioco</h1>
    </div>

    <div class="form-card">
        <form method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="Game.Title">🎮 Titolo *</label>
                <input asp-for="Game.Title" class="form-control" placeholder="Es. The Legend of Zelda: TOTK" />
                <span asp-validation-for="Game.Title" class="field-error"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Game.Platform">🖥️ Piattaforma *</label>
                    <select asp-for="Game.Platform" class="form-control">
                        <option value="">Seleziona...</option>
                        @foreach (var p in platforms)
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                    <span asp-validation-for="Game.Platform" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Game.PersonalScore">⭐ Voto (1-10) *</label>
                    <input asp-for="Game.PersonalScore" type="number" min="1" max="10" class="form-control" />
                    <span asp-validation-for="Game.PersonalScore" class="field-error"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Game.Genre">🏷️ Genere</label>
                <input asp-for="Game.Genre" class="form-control" placeholder="Es. RPG, Action, Platformer..." />
            </div>

            <div class="form-group">
                <label asp-for="Game.ImageUrl">🖼️ URL Immagine (opzionale)</label>
                <input asp-for="Game.ImageUrl" class="form-control" placeholder="https://..." />
            </div>

            <div class="form-group">
                <label asp-for="Game.Notes">📝 Note personali</label>
                <textarea asp-for="Game.Notes" class="form-control" rows="3"
                          placeholder="Cosa ti è piaciuto? Consiglieresti questo gioco?"></textarea>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">✅ Aggiungi alla Collezione</button>
                <a asp-page="/Collection/Index" class="btn btn-ghost">Annulla</a>
            </div>
        </form>
    </div>
</div>
